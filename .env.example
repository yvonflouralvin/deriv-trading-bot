# Variables de la plateforme (à coller dans l'onglet Environment de Dokploy,
# ou dans un fichier .env à la racine pour docker compose en local).

# Base de données
POSTGRES_PASSWORD=choisir_un_mot_de_passe_long

# Mot de passe d'accès au Monitor (demandé à l'ouverture de l'interface)
API_TOKEN=choisir_un_autre_secret_long

# Deriv (developers.deriv.com)
DERIV_APP_ID=352BAYW4UZ2N6SuCWgNFw
DERIV_TOKEN=collez_ici_votre_token_API
# DERIV_ACCOUNT_ID=          # optionnel : forcer un compte (sinon le 1er compte démo)

# Actifs suivis au tout premier démarrage (ensuite : depuis le Monitor)
DEFAULT_SYMBOLS=R_100,R_75,1HZ100V

# Unités de temps des bougies, en secondes
TIMEFRAMES=60,300,900,3600,14400,86400

# Interrupteur général du trading démo (0 = tout en paper, même les stratégies réglées en démo)
DEMO_TRADING_ENABLED=1

# Unités de temps de la tendance multi-timeframe (de la plus grande à la plus petite) : H4, H1, M15
TREND_TFS=14400,3600,900
